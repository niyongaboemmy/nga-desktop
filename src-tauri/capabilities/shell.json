{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "shell",
  "description": "The local shell UI (title bar, settings) and its floating overlay window. Applies to the `shell` and `overlay` webviews only; the NGA app webviews load remote origins and get only the bridge (see lib.rs grant_bridge).",
  "webviews": [
    "shell",
    "overlay"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "store:default",
    "notification:default",
    "process:allow-restart",
    "updater:default",
    "allow-shell-info",
    "allow-open-app",
    "allow-set-insets",
    "allow-set-covered",
    "allow-reload-active",
    "allow-go-back",
    "allow-go-forward",
    "allow-print-active",
    "allow-open-active-in-browser",
    "allow-show-downloads",
    "allow-sign-out",
    "allow-reset-profile",
    "allow-notices-list",
    "allow-notices-summary",
    "allow-notices-open",
    "allow-notices-read-all",
    "allow-notices-clear",
    "allow-navigate-app",
    "allow-set-window-theme",
    "allow-popup-menu",
    "allow-os-permission",
    "allow-os-permission-request",
    "allow-os-open-settings",
    "allow-os-test-banner",
    "allow-focus-session",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-is-maximized",
    "core:webview:allow-set-webview-focus",
    "allow-overlay-show",
    "allow-overlay-hide",
    "allow-overlay-action",
    "allow-signin-cancel",
    "allow-signin-reopen"
  ]
}
