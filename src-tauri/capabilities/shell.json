{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "shell",
  "description": "The local shell UI (sidebar, header, settings). Applies to the `shell` webview only; the NGA app webviews load remote origins and get no IPC at all.",
  "webviews": ["shell"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "store:default",
    "notification:default",
    "process:allow-restart",
    "updater:default",
    "allow-shell-info",
    "allow-open-app",
    "allow-set-insets",
    "allow-set-covered",
    "allow-reload-active",
    "allow-go-back",
    "allow-go-forward",
    "allow-print-active",
    "allow-open-active-in-browser",
    "allow-show-downloads",
    "allow-sign-out",
    "allow-reset-profile"
  ]
}
