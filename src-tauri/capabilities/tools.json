{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "tools",
  "description": "Tool windows (pop-out and present). They load the shell's own page (index.html?tool=<id>) and get only what the tools need: their data, timers, saving to Downloads and their own window controls. Never the NGA app pages.",
  "windows": [
    "tool-*",
    "present-*"
  ],
  "permissions": [
    "core:default",
    "store:default",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-set-always-on-top",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "core:window:allow-set-title",
    "allow-tools-identity",
    "allow-timers-list",
    "allow-timer-create",
    "allow-timer-action",
    "allow-tools-window-open",
    "allow-tools-displays",
    "allow-tools-save-file"
  ]
}
