{
  "name": "nga-desktop",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:dev:local": "NGA_ENV=development tauri dev",
    "bundle": "tauri build",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "release": "node scripts/bump-version.mjs",
    "fake-apps": "node scripts/fake-apps.mjs",
    "tauri:dev:fake": "NGA_ENV=development tauri dev --config src-tauri/tauri.dev.conf.json",
    "licences": "node scripts/check-licences.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-global-shortcut": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-store": "^2.5.0",
    "@tauri-apps/plugin-updater": "^2.13.1",
    "dompurify": "^3.4.16",
    "katex": "^0.19.0",
    "lucide-react": "^1.51.0",
    "marked": "^18.1.0",
    "mathjs": "^15.2.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ts-fsrs": "^5.4.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/react": "^16.3.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.11"
  },
  "description": "NGA Desktop: one native app (Windows/macOS) hosting NGA MIS, Task Mentor, Tendo and Tupo",
  "engines": {
    "node": ">=20"
  }
}
